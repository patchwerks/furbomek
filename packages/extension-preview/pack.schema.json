{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Furb-o-Mek data-only extension preview pack v1",
  "$comment": "parsePack additionally enforces byte/UTF-8/duplicate-key/depth limits, contiguous sequence, ordered times below duration, declared capabilities and neutral time zero. JSON Schema alone is not the acceptance boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "previewContractVersion",
    "capabilities",
    "durationMs",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])",
      "maxLength": 64
    },
    "packVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
      "maxLength": 32
    },
    "previewContractVersion": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "presentation.expression",
          "presentation.reaction"
        ]
      },
      "contains": {
        "const": "presentation.expression"
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/event"
      },
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "properties": {
                "seq": {
                  "const": 1
                },
                "atMs": {
                  "const": 0
                },
                "kind": {
                  "const": "presentation.expression"
                },
                "value": {
                  "const": "neutral"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "atMs",
        "kind",
        "value"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29999
        },
        "kind": {
          "enum": [
            "presentation.expression",
            "presentation.reaction"
          ]
        },
        "value": {
          "enum": [
            "neutral",
            "curious",
            "acknowledge"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "presentation.expression"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "neutral",
                  "curious"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "const": "acknowledge"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "atMs": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "presentation.expression"
              },
              "value": {
                "const": "neutral"
              }
            }
          }
        }
      ]
    }
  }
}
