+bool FNHRRemote::SendPacket(byte* buffer, byte length)
+{
+  rf24.stopListening();
+  bool written = rf24.write(buffer, length);
+  rf24.startListening();
+  return written;
+}
+
+bool FNHRRemote::ReceivePacket(byte* buffer, byte& length, byte& pipe)
+{
+  if (!rf24.available(&pipe))
+    return false;
+  length = rf24.getDynamicPayloadSize();
+  if (length == 0 || length > outDataSize)
+  {
+    rf24.flush_rx();
+    return false;
+  }
+  rf24.read(buffer, length);
+  return true;
+}
+
+bool FNHRRemote::SendManualPacket(byte* buffer, byte length)
+{
+  if (length > outDataSize - 3)
+    return false;
+  byte packet[outDataSize];
+  packet[0] = 0x52;
+  packet[1] = 2;
+  packet[2] = length;
+  for (byte index = 0; index < length; ++index)
+    packet[index + 3] = buffer[index];
+  return SendPacket(packet, length + 3);
+}
