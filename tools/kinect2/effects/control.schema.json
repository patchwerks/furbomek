{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"furbomek.effects.v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","consumer_id","cue_id","owner","expected_revision","revision","issued_ms","duration_ms","look","point_pixels","zoom","yaw","pitch","hud_visible","insets_visible","framing","pulse_hz","intensity_percent"],
  "properties":{
    "schema_version":{"const":"furbomek.effects.v1"},
    "consumer_id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"},
    "cue_id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"},
    "owner":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"},
    "expected_revision":{"type":"integer","minimum":0,"maximum":2147483646},
    "revision":{"type":"integer","minimum":1,"maximum":2147483647},
    "issued_ms":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "duration_ms":{"type":"integer","minimum":1,"maximum":30000},
    "look":{"enum":["rgb.fixed.v1","rgb.crimson.v1","xyz.depth.v1","xyz.crimson.v1"]},
    "point_pixels":{"type":"number","minimum":0.75,"maximum":3.6},
    "zoom":{"type":"number","minimum":0.7,"maximum":1.5},
    "yaw":{"type":"number","minimum":-0.55,"maximum":0.55},
    "pitch":{"type":"number","minimum":-0.32,"maximum":0.32},
    "hud_visible":{"type":"boolean"},"insets_visible":{"type":"boolean"},
    "pulse_hz":{"type":"number","minimum":0,"maximum":1},
    "intensity_percent":{"type":"integer","minimum":0,"maximum":100},
    "framing":{"type":"object","additionalProperties":false,"required":["subject_id","rules","ttl_ms"],"properties":{
      "subject_id":{"type":"string","pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"},
      "rules":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["subject","fixed","hold"]}},
      "ttl_ms":{"type":"integer","minimum":1,"maximum":600}
    }}
  }
}
